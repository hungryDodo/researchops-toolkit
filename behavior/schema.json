{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchOps behavior event",
  "type": "object",
  "properties": {
    "hook_event_name": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {},
    "agent_type": {
      "type": "string"
    },
    "active_skill": {
      "type": "string"
    },
    "behavior_mode": {
      "enum": [
        "off",
        "observe",
        "guide",
        "enforce"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

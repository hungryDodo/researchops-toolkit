{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchOps generated model dossier compatibility view",
  "type": "object",
  "required": ["generated", "do_not_edit", "execution_arm_id", "profile_slices"],
  "properties": {
    "generated": {"const": true},
    "do_not_edit": {"const": true},
    "execution_arm_id": {"type": "string", "minLength": 1},
    "profile_slices": {"type": "array", "items": {"type": "object"}},
    "failure_patterns": {"type": "array", "items": {"type": "object"}},
    "mitigations": {"type": "array", "items": {"type": "object"}},
    "deployment_epochs": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/evaluation-event-v2.json",
  "title": "ResearchOps Evaluation Event V2",
  "type": "object",
  "required": ["project_id", "source", "execution_arm_id", "task", "outcome", "usage", "verification"],
  "properties": {
    "schema_version": {"const": 2},
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "work_unit_id": {"type": ["string", "null"]},
    "route_decision_id": {"type": ["string", "null"]},
    "source": {"enum": ["live", "shadow", "anchor"]},
    "execution_arm_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "required": ["orientation", "operation", "primary_artifact", "risk", "privacy", "mutability"],
      "properties": {
        "objective": {"type": "string"},
        "orientation": {"enum": ["research-led", "development-led", "mixed", "unknown"]},
        "operation": {"enum": ["orchestrate", "discover", "design", "implement", "debug", "validate", "communicate", "operate", "unknown"]},
        "primary_artifact": {"enum": ["code", "experiment", "analysis", "document", "visual", "system", "unknown"]},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "privacy": {"enum": ["public", "internal", "confidential", "restricted"]},
        "mutability": {"enum": ["read-only", "workspace-write", "external-write", "hardware-write", "destructive"]},
        "reasoning_demand": {"enum": ["low", "medium", "high", "extreme"]},
        "decomposability": {"enum": ["low", "medium", "high"]},
        "dependency_structure": {"enum": ["independent", "mixed", "sequential"]},
        "tool_intensity": {"enum": ["low", "medium", "high"]},
        "shared_mutable_state": {"type": "boolean"},
        "reasoning_effort": {"type": ["string", "null"], "enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra", null]},
        "min_reasoning_effort": {"type": ["string", "null"], "enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra", null]},
        "max_reasoning_effort": {"type": ["string", "null"], "enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra", null]},
        "model_family_allowlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "uncertain_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acceptance_profile": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["accepted", "verified_progress", "quality"],
      "properties": {
        "accepted": {"type": "boolean"},
        "verified_progress": {"type": "number", "minimum": 0, "maximum": 1},
        "quality": {"type": "number", "minimum": 0, "maximum": 1},
        "human_correction": {"type": "number", "minimum": 0, "maximum": 1},
        "verifier_disagreement": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "latency_seconds", "cost_amount", "currency"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0},
        "cost_amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 3},
        "price_quote_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "verification": {"type": "object"},
    "failure_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "attribution": {"enum": ["worker-model", "task-contract", "tool", "provider", "harness", "judge", "environment", "unknown"]},
          "description": {"type": "string"},
          "evidence_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "versions": {"type": "object"},
    "registry_eligible": {"type": "boolean"},
    "selection_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "supersedes_event_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

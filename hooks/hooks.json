{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "researchops-session",
            "type": "command",
            "command": "python \"${extensionPath}${/}hooks${/}researchops_hook.py\" --framework gemini",
            "timeout": 10000,
            "description": "Load compact ResearchOps behavior context"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "researchops-task-behavior",
            "type": "command",
            "command": "python \"${extensionPath}${/}hooks${/}researchops_hook.py\" --framework gemini",
            "timeout": 10000,
            "description": "Classify the task and inject relevant behavior packs"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command|write_file|replace|mcp_.*",
        "hooks": [
          {
            "name": "researchops-tool-policy",
            "type": "command",
            "command": "python \"${extensionPath}${/}hooks${/}researchops_hook.py\" --framework gemini",
            "timeout": 10000,
            "description": "Check deterministic high-risk operations"
          }
        ]
      }
    ]
  }
}

{
  "schema_version": 1,
  "providers": {
    "openai": {
      "display_name": "OpenAI API",
      "protocol": "openai-chat",
      "base_url": "https://api.openai.com/v1",
      "credential_env": ["OPENAI_API_KEY"],
      "model_list_path": "/models",
      "docs": [
        "https://platform.openai.com/docs/quickstart",
        "https://platform.openai.com/docs/api-reference/models"
      ],
      "default_trust_zone": "external-approved"
    },
    "anthropic": {
      "display_name": "Anthropic API",
      "protocol": "anthropic-messages",
      "base_url": "https://api.anthropic.com",
      "credential_env": ["ANTHROPIC_API_KEY"],
      "api_version": "2023-06-01",
      "model_list_path": "/v1/models",
      "docs": [
        "https://docs.anthropic.com/en/api/messages",
        "https://docs.anthropic.com/en/api/models-list"
      ],
      "default_trust_zone": "external-approved"
    },
    "google-gemini": {
      "display_name": "Google Gemini API",
      "protocol": "google-generate-content",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "credential_env": ["GOOGLE_API_KEY", "GEMINI_API_KEY"],
      "model_list_path": "/models",
      "docs": [
        "https://ai.google.dev/gemini-api/docs/api-key",
        "https://ai.google.dev/api/models",
        "https://ai.google.dev/api/generate-content"
      ],
      "default_trust_zone": "external-approved"
    },
    "deepseek": {
      "display_name": "DeepSeek API",
      "protocol": "openai-chat",
      "base_url": "https://api.deepseek.com",
      "credential_env": ["DEEPSEEK_API_KEY"],
      "model_list_path": "/models",
      "docs": [
        "https://api-docs.deepseek.com/",
        "https://api-docs.deepseek.com/api/list-models"
      ],
      "default_trust_zone": "external-approved"
    },
    "openrouter": {
      "display_name": "OpenRouter",
      "protocol": "openai-chat",
      "base_url": "https://openrouter.ai/api/v1",
      "credential_env": ["OPENROUTER_API_KEY"],
      "model_list_path": "/models",
      "default_headers_env": {
        "HTTP-Referer": "OPENROUTER_HTTP_REFERER",
        "X-OpenRouter-Title": "OPENROUTER_APP_TITLE"
      },
      "docs": [
        "https://openrouter.ai/docs/quickstart",
        "https://openrouter.ai/docs/api/reference/models/get-models"
      ],
      "default_trust_zone": "external-approved"
    },
    "litellm": {
      "display_name": "LiteLLM Gateway",
      "protocol": "openai-chat",
      "base_url": "http://127.0.0.1:4000/v1",
      "credential_env": ["LITELLM_API_KEY"],
      "model_list_path": "/models",
      "docs": [
        "https://docs.litellm.ai/"
      ],
      "default_trust_zone": "gateway-approved"
    },
    "local-openai-compatible": {
      "display_name": "Local OpenAI-compatible server",
      "protocol": "openai-chat",
      "base_url": "http://127.0.0.1:8000/v1",
      "credential_env": ["LOCAL_MODEL_API_KEY"],
      "credential_optional": true,
      "model_list_path": "/models",
      "docs": [],
      "default_trust_zone": "local-approved"
    }
  }
}

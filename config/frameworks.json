{
  "schema_version": 2,
  "canonical_skill_root": "skills",
  "shared_agent_registry": ".research/agents",
  "frameworks": {
    "codex": {
      "skill_user": "~/.agents/skills",
      "skill_project": ".agents/skills",
      "agent_user": "~/.codex/agents",
      "agent_project": ".codex/agents",
      "agent_format": "toml",
      "legacy_skill_paths": ["~/.codex/skills", ".codex/skills"]
    },
    "claude": {
      "skill_user": "~/.claude/skills",
      "skill_project": ".claude/skills",
      "agent_user": "~/.claude/agents",
      "agent_project": ".claude/agents",
      "agent_format": "markdown-frontmatter"
    },
    "gemini": {
      "skill_user": "~/.gemini/skills",
      "skill_project": ".gemini/skills",
      "agent_user": "~/.gemini/agents",
      "agent_project": ".gemini/agents",
      "agent_format": "markdown-frontmatter"
    },
    "portable": {
      "skill_user": "~/.agent-skills/skills",
      "skill_project": ".agent-skills/skills",
      "agent_user": "~/.agent-os/agents",
      "agent_project": ".agent-os/agents",
      "agent_format": "registry-json"
    }
  }
}

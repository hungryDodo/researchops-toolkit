{
  "schema_version": 2,
  "purpose": "Bounded service and identity checks that never update competence profiles.",
  "checks": [
    {"id": "connectivity", "kind": "endpoint", "updates": ["endpoint-health"]},
    {"id": "strict-json", "kind": "format", "updates": ["identity-observation"]},
    {"id": "tool-shape", "kind": "tool-schema", "updates": ["identity-observation"]},
    {"id": "returned-model", "kind": "declared-identity", "updates": ["identity-observation"]},
    {"id": "latency-token-shape", "kind": "operational-fingerprint", "updates": ["endpoint-health", "identity-observation"]}
  ],
  "forbidden_updates": ["evaluation-events", "profile-slices", "failure-patterns", "routing-competence"]
}

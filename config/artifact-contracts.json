        "phase",
        "next_owner",
        "gate",
        "evidence_blocker",
        "safeguard_proposals"
      ]
    },
    "survey-corpus": {
      "owner": "research-discovery",
      "required": [
        "research_questions",
        "sources",
        "query_log",
        "inclusion_rules",
        "provenance_labels",
        "closest_work_matrix",
        "evidence_gaps"
      ]
    },
    "route-card": {
      "owner": "research-route-evaluator",
      "required": [
        "hypothesis",
        "mechanism",
        "fatal_flaws",
        "closest_work_collision",
        "resource_fit",
        "minimum_experiment",
        "kill_criterion",
        "budget"
      ]
    },
    "experiment-package": {
      "owner": "experimental-research",
      "required": [
        "design_hash",
        "variables",
        "baselines",
        "metrics",
        "statistics",
        "commands",
        "environment",
        "artifacts",
        "failures",
        "structured_results"
      ]
    },
    "hardware-run": {
      "owner": "hardware-experiment-loop",
      "required": [
